@startuml esha_D07_system_architecture
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 14
skinparam dpi 300
skinparam nodesep 35
skinparam ranksep 35
skinparam package {
BackgroundColor #F8F9FA
BorderColor #4A5568
FontColor #1A202C
FontStyle bold
}
skinparam component {
BackgroundColor #EDF2F7
BorderColor #2B6CB0
FontColor #2D3748
}
skinparam database {
BackgroundColor #EBF8FF
BorderColor #2B6CB0
FontColor #2C5282
}
skinparam arrow {
Color #4A5568
Thickness 1.2
FontColor #2D3748
FontSize 12
}

title Zeest System Architecture

actor Physician

package "Web Client" as ClientLayer {
  component [Next.js Web Interface\nConsultation | Case | Review | Audit] as WebUI
}

package "Application Backend" as BackendLayer {
  component [FastAPI Gateway\nAuthentication | Validation | Routing] as API
  WebUI --> API : HTTPS / WebSocket
}

package "Agent Processing" as AgentLayer {
  component [Workflow Orchestrator\nLangGraph / Google ADK role split: TBD] as Orchestrator
  component [Context Agents\nPatient Memory | Clinical Case] as ContextAgents
  component [Specialist Agents\nImaging | Laboratory | Medication Safety] as SpecialistAgents
  component [Review Agents\nEvidence & RAG | Clinical Reasoning | Safety & Critic] as ReviewAgents
  Orchestrator --> ContextAgents
  Orchestrator --> SpecialistAgents
  Orchestrator --> ReviewAgents
}

package "Models and External Evidence" as Models {
  component [Speech-to-Text\nEngine: TBD] as Transcriber
  component [Gemini\nReasoning API] as GeminiModel
  component [Validated Imaging Classifier\nPyTorch checkpoint: TBD] as ImagingModel
  database "External Clinical Guidelines" as Guidelines
  database "Medication Knowledge Resource" as MedicationKB
  Transcriber -[hidden]down-> GeminiModel
  GeminiModel -[hidden]down-> ImagingModel
  ImagingModel -[hidden]down-> Guidelines
}

package "Hybrid Patient Memory" as DataLayer {
  database "PostgreSQL\nEncounters | Proposals | Decisions | Audit" as PostgreSQL
  database "pgvector Extension\nPatient Memory | Evidence Index" as Pgvector
}

Physician --> WebUI : Clinical workflow
SpecialistAgents --> MedicationKB : Medication checks
API --> Orchestrator : Structured case request
API --> Transcriber : Consultation audio
ContextAgents --> PostgreSQL : Longitudinal records
ContextAgents --> Pgvector : Semantic retrieval
SpecialistAgents --> ImagingModel : Imaging inference
ReviewAgents --> GeminiModel : Reasoning and critique
ReviewAgents --> Guidelines : Cited evidence
ReviewAgents --> Pgvector : Evidence retrieval
API --> PostgreSQL : Approved decision and audit
component [Memory Indexer] as Indexer
API --> Indexer : Authorised input revisions / approved decisions
Indexer --> Pgvector : Store source-linked embeddings
PostgreSQL -- Pgvector : Relational and vector storage

@enduml
