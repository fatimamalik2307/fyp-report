@startuml
title Zeest variant comparison design
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 300
skinparam defaultFontName Arial
skinparam componentStyle rectangle

package "Shared evaluation inputs" {
  [Frozen case set] as cases
  [Reference judgement process] as refs
  [Common scoring rubric] as rubric
}

package "Variants under comparison" {
  [Single LLM baseline] as baseline
  [Memory-augmented variant] as memory
  [Full Zeest system] as full
}

package "Controlled contrasts" {
  [With vs without critic review] as critic
  [Text-only vs multimodal inputs] as multimodal
}

[Recorded outputs and configurations] as outputs
[Comparative assessment after execution] as report

cases --> baseline
cases --> memory
cases --> full
cases --> critic
cases --> multimodal
refs --> rubric
baseline --> outputs
memory --> outputs
full --> outputs
critic --> outputs
multimodal --> outputs
outputs --> rubric
rubric --> report
@enduml
